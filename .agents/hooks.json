{
  "devkit": {
    "SessionStart": [{ "type": "command", "command": "node .agents/hooks/devkit-hook.mjs antigravity session-start", "timeout": 10 }],
    "PreToolUse": [
      { "matcher": "run_command", "hooks": [{ "type": "command", "command": "node .agents/hooks/devkit-hook.mjs antigravity guard", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "write_to_file|replace_file_content|multi_replace_file_content", "hooks": [{ "type": "command", "command": "node .agents/hooks/devkit-hook.mjs antigravity track", "timeout": 10 }] }
    ],
    "Stop": [{ "type": "command", "command": "node .agents/hooks/devkit-hook.mjs antigravity stop", "timeout": 10 }]
  }
}
